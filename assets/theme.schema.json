{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/doubao-skin/theme.schema.json",
  "title": "Doubao Skin theme",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "colors"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "background": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(png|jpe?g|webp)$"
    },
    "colors": {
      "$ref": "#/$defs/baseColors"
    },
    "typography": {
      "$ref": "#/$defs/typography"
    },
    "composer": {
      "$ref": "#/$defs/composer"
    },
    "surfaces": {
      "$ref": "#/$defs/surfaces"
    },
    "decoration": {
      "$ref": "#/$defs/decoration"
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^(#[0-9A-Fa-f]{6}|rgba?\\([0-9., %]+\\))$"
    },
    "baseColors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accent",
        "accentSoft",
        "cyan",
        "pink",
        "text",
        "muted",
        "panel",
        "panelStrong",
        "line"
      ],
      "properties": {
        "accent": {
          "$ref": "#/$defs/color"
        },
        "accentSoft": {
          "$ref": "#/$defs/color"
        },
        "cyan": {
          "$ref": "#/$defs/color"
        },
        "pink": {
          "$ref": "#/$defs/color"
        },
        "text": {
          "$ref": "#/$defs/color"
        },
        "muted": {
          "$ref": "#/$defs/color"
        },
        "panel": {
          "$ref": "#/$defs/color"
        },
        "panelStrong": {
          "$ref": "#/$defs/color"
        },
        "line": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "muted",
        "subtle",
        "disabled",
        "heading",
        "sidebar",
        "sidebarMuted",
        "suggestion",
        "action",
        "link"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/color"
        },
        "secondary": {
          "$ref": "#/$defs/color"
        },
        "muted": {
          "$ref": "#/$defs/color"
        },
        "subtle": {
          "$ref": "#/$defs/color"
        },
        "disabled": {
          "$ref": "#/$defs/color"
        },
        "heading": {
          "$ref": "#/$defs/color"
        },
        "sidebar": {
          "$ref": "#/$defs/color"
        },
        "sidebarMuted": {
          "$ref": "#/$defs/color"
        },
        "suggestion": {
          "$ref": "#/$defs/color"
        },
        "action": {
          "$ref": "#/$defs/color"
        },
        "link": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "composer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "placeholder",
        "toolbar",
        "iconFilter",
        "background",
        "backgroundAccent",
        "border"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/color"
        },
        "placeholder": {
          "$ref": "#/$defs/color"
        },
        "toolbar": {
          "$ref": "#/$defs/color"
        },
        "iconFilter": {
          "type": "string",
          "pattern": "^brightness\\(0%\\) saturate\\(100%\\) invert\\([0-9]{1,3}%\\) sepia\\([0-9]{1,3}%\\) saturate\\([0-9]{1,5}%\\) hue-rotate\\(-?[0-9]{1,3}deg\\) brightness\\([0-9]{1,3}%\\) contrast\\([0-9]{1,3}%\\)$"
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "backgroundAccent": {
          "$ref": "#/$defs/color"
        },
        "border": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation",
        "menu"
      ],
      "properties": {
        "conversation": {
          "$ref": "#/$defs/color"
        },
        "menu": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "decoration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "lines": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    }
  }
}
